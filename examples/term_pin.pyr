imp std/term
imp std/io { print, println }

fn main() {
  if !term.is_tty() {
    println("pin demo requires a terminal")
    return nil
  }

  rows = term.rows()
  start = term.cursor_row()
  log_end = rows - 3
  status_row = rows - 2

  // push content down to make room if we're near the bottom
  needed = rows - start
  for i in range(needed) {
    println("")
  }

  term.hide_cursor()
  term.scroll_region(start, log_end)
  term.move(start, 0)

  for i in range(50) {
    println("  processed item_{i}")

    term.save()
    term.move(status_row, 0)
    term.clear_line()
    print(term.style("[{i}/50]", { fg: "cyan" }) + " processing...")
    term.move(status_row + 1, 0)
    term.clear_line()
    print("  current: item_{i}.dat")
    term.restore()

    for j in range(200000) {}
  }

  term.save()
  term.move(status_row, 0)
  term.clear_line()
  print(term.style("[50/50]", { fg: "green" }) + " complete")
  term.move(status_row + 1, 0)
  term.clear_line()
  term.restore()

  term.reset_scroll()
  term.show_cursor()
  term.move(status_row + 1, 0)
  println("")
}
