imp std/term
imp std/io { print, println }

fn main() {
  if !term.is_tty() {
    println("pin demo requires a terminal")
    return nil
  }

  term.hide_cursor()

  for i in range(50) {
    // log line scrolls normally
    println("  processed item_{i}")

    // jump down 1 line, write status, jump back up 1 line
    term.clear_line()
    print(term.style("  [{i + 1}/50]", { fg: "cyan" }) + " processing... item_{i}.dat")
    term.up(1)
    term.move_to_col(0)

    for j in range(200000) {}
  }

  // move to the status line and finalize
  term.down(1)
  term.clear_line()
  println(term.style("  [50/50]", { fg: "green" }) + " complete")
  term.show_cursor()
}
